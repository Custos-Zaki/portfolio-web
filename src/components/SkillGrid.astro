---
const skills = [
  {
    name: "Machine Learning",
    description: "Supervised & unsupervised learning — classification, regression, clustering, dimensionality reduction. Full pipeline from raw data to deployed model.",
    techs: ["Scikit-Learn", "XGBoost", "Python", "Pandas"]
  },
  {
    name: "Statistical Analysis",
    description: "Hypothesis testing, non-parametric correlation, probability modeling, distribution fitting, and rigorous exploratory analysis.",
    techs: ["R", "Python", "SciPy", "StatsModels"]
  },
  {
    name: "Data Pipelines & Integration",
    description: "Real-time ingestion pipelines, automated ETL workflows, multi-system data integration, CSV/JSON processing, and scheduled reporting architectures.",
    techs: ["Python", "SQL", "APIs", "File Systems"]
  },
  {
    name: "Business Analytics",
    description: "Customer segmentation, RFM analysis, cohort modeling, probabilistic CLV forecasting, and revenue attribution analysis.",
    techs: ["Python", "Pandas", "BG/NBD", "Gamma-Gamma"]
  }
];
---

<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-2 max-w-3xl mx-auto">
  {skills.map((skill) => (
    <div class="relative overflow-hidden rounded-xl border border-brand-secondary/60 bg-brand-primary p-6 shadow-brand-sm transition-all duration-300 hover:border-brand-accent/30 hover:shadow-[0_0_15px_rgba(0,212,255,0.04)]">
      <div class="mb-3">
        <h4 class="font-display text-lg font-bold text-brand-text">
          {skill.name}
        </h4>
      </div>
      <p class="text-xs text-brand-muted leading-relaxed mb-4 min-h-[48px] font-sans">
        {skill.description}
      </p>
      <div class="flex flex-wrap gap-1">
        {skill.techs.map((tech) => (
          <span class="text-[10px] font-mono text-brand-text bg-brand-secondary/35 px-2 py-0.5 rounded border border-brand-secondary/30">
            {tech}
          </span>
        ))}
      </div>
    </div>
  ))}
</div>
