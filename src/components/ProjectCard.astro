---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, date, tags, coverImage, category } = project.data;
const baseUrl = import.meta.env.BASE_URL;
const cleanBase = baseUrl.endsWith('/') ? baseUrl : baseUrl + '/';
const cleanSlug = project.id.endsWith('/index') ? project.id.slice(0, -6) : project.id;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
}).toUpperCase();

const visualCount = String(project.data.visualizations?.length || 0).padStart(2, '0');
const swatchColors = ["bg-white", "bg-[#4A89C8]", "bg-[#B8C9D9]", "bg-[#879BAE]"];
---

<a 
  href={`${cleanBase}projects/${cleanSlug}/`} 
  class="group block relative h-full clip-chamfer-br bg-[#2D3E4E] p-4 sm:p-5 transition-all duration-300 hover:bg-[#243342] cursor-pointer"
>
  <div class="relative z-10 flex flex-col h-full justify-between">
    
    <div>
      <!-- Chamfered Glacier Image Frame (Adaptasi Kartu Katalog #B8C9D9 FRZN) -->
      <div class="clip-chamfer-sm relative aspect-[16/10] w-full overflow-hidden bg-[#B8C9D9] mb-4 p-2 border border-white/25">
        <!-- Radial Floor Shadow -->
        <div class="glacier-floor-shadow absolute bottom-1 inset-x-4 h-4 rounded-full pointer-events-none"></div>
        
        <img 
          src={`${cleanBase}images/${coverImage}`} 
          alt={title}
          class="relative z-10 h-full w-full object-cover rounded-[2px] transition-transform duration-500 group-hover:scale-[1.03]"
          loading="lazy"
        />

        <!-- Solid White Category Pill (Gaya Tombol FILTERS FRZN) -->
        <span class="absolute top-3 left-3 z-20 rounded-[3px] bg-white px-2.5 py-0.5 text-[9px] font-mono font-bold uppercase tracking-[0.14em] text-[#1E2936] shadow-sm">
          {category}
        </span>

        <!-- Corner Action Arrow Indicator -->
        <span class="absolute top-3 right-3 z-20 w-6 h-6 rounded-[3px] bg-[#1E2936]/85 backdrop-blur-sm text-white flex items-center justify-center text-[11px] font-mono opacity-0 group-hover:opacity-100 transition-opacity duration-200">
          ↗
        </span>
      </div>

      <!-- Technical Telemetry Row (Date & Visuals Count) -->
      <div class="flex items-center justify-between text-[10px] font-mono tracking-[0.14em] text-[#879BAE] uppercase mb-2">
        <time datetime={date.toISOString()}>[ {formattedDate} ]</time>
        <span class="text-[#B8C9D9]">
          FIGS // {visualCount}
        </span>
      </div>

      <!-- Condensed Display Project Title -->
      <h3 class="font-display text-2xl tracking-tight text-white uppercase leading-[0.98] mb-2 group-hover:text-[#B8C9D9] transition-colors">
        {title}<sup class="text-[10px] ml-0.5 font-sans font-bold text-[#879BAE]">™</sup>
      </h3>

      <!-- Crisp, Concise Description (Clamped to 2 Lines for K.I.S.S. Cleanliness) -->
      <p class="text-xs text-[#B0C2D1] line-clamp-2 mb-5 leading-relaxed font-sans">
        {description}
      </p>
    </div>

    <!-- Bottom Spec Swatch Tags (Gaya ● WHITE ● SILVER pada Katalog FRZN) -->
    <div class="flex flex-wrap items-center gap-x-3.5 gap-y-1.5 mt-auto pt-3 border-t border-white/15">
      {tags.slice(0, 4).map((tag, index) => (
        <span class="inline-flex items-center gap-1.5 text-[10px] font-mono tracking-[0.1em] uppercase text-[#B0C2D1] group-hover:text-white transition-colors">
          <i class={`w-1.5 h-1.5 rounded-full inline-block ${swatchColors[index % swatchColors.length]}`}></i>
          {tag}
        </span>
      ))}
    </div>

  </div>
</a>