---
import '../styles/global.css';
import LightPillar from '../components/LightPillar.astro';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "custos.zaki - Quantitative Research & Statistical Modeling Portfolio" 
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const cleanBase = baseUrl.endsWith('/') ? baseUrl : baseUrl + '/';
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-brand-bg text-brand-text">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${cleanBase}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Math Equation Rendering (KaTeX) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css" />
  </head>
  <body class="min-h-screen flex flex-col antialiased selection:bg-brand-accent selection:text-brand-bg relative overflow-x-hidden">
    <!-- Animated WebGL Aurora Background -->
    <div class="fixed inset-0 -z-30 overflow-hidden bg-brand-bg pointer-events-none select-none">
      <!-- LightPillar WebGL Background -->
      <LightPillar
        topColor="#4BB8FA"
        bottomColor="#2C5EAD"
        intensity={1.0}
        rotationSpeed={0.3}
        glowAmount={0.005}
        pillarWidth={3.0}
        pillarHeight={0.4}
        noiseIntensity={0.5}
        pillarRotation={90}
        interactive={true}
        mixBlendMode="normal"
      />
    </div>
    <!-- Header / Navbar -->
    <header class="sticky top-0 z-50 w-full border-b border-brand-primary bg-brand-bg/60 backdrop-blur-md transition-all duration-300">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <a href={cleanBase} class="flex items-center gap-2 font-display text-lg font-bold tracking-tight text-brand-text hover:opacity-90 transition-opacity duration-200 cursor-pointer">
          <img src={`${cleanBase}images/logo_custos.png`} alt="custos.zaki logo" class="h-8 w-auto object-contain" />
        </a>
        <nav class="flex items-center gap-6 text-sm font-medium">
          <a href={`${cleanBase}#services`} class="hover:text-brand-accent transition-colors duration-200 cursor-pointer">Services</a>
          <a href={`${cleanBase}#projects`} class="hover:text-brand-accent transition-colors duration-200 cursor-pointer">Projects</a>
          <a href={`${cleanBase}#skills`} class="hover:text-brand-accent transition-colors duration-200 cursor-pointer">Skills</a>
          <a href={`${cleanBase}#about`} class="hover:text-brand-accent transition-colors duration-200 cursor-pointer">About</a>
          <a href={`${cleanBase}#contact`} class="inline-flex items-center justify-center rounded-md bg-gradient-to-r from-brand-accent to-brand-violet px-4 py-2 text-xs font-semibold text-brand-bg hover:opacity-90 hover:shadow-[0_0_15px_rgba(21,145,220,0.25)] transition-all duration-200 cursor-pointer hover:-translate-y-[1px]">
            Contact
          </a>
        </nav>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-brand-primary bg-brand-bg/40 backdrop-blur-sm py-12 text-brand-muted">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col items-center justify-between gap-6 md:flex-row">
          <div class="text-center md:text-left">
            <p class="font-display font-bold text-brand-text">Muhammad Zaki Rifa'at</p>
            <p class="text-xs mt-1">Quantitative Research & Statistical Modeling</p>
          </div>
          
          <!-- Social Icons -->
          <div class="flex items-center gap-5">
            <!-- GitHub -->
            <a 
              href="https://github.com/custos-zaki" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="hover:text-brand-accent transition-colors duration-200 cursor-pointer" 
              aria-label="GitHub Profile"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                <path d="M9 18c-4.51 2-5-2-7-2"></path>
              </svg>
            </a>
            <!-- LinkedIn -->
            <a 
              href="https://www.linkedin.com/in/muhammad-zaki-rifaat/" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="hover:text-brand-accent transition-colors duration-200 cursor-pointer" 
              aria-label="LinkedIn Profile"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect x="2" y="9" width="4" height="12"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
            </a>
            <!-- Instagram -->
            <a 
              href="https://instagram.com/zki_f" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="hover:text-brand-accent transition-colors duration-200 cursor-pointer" 
              aria-label="Instagram Profile"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </a>
          </div>
        </div>
        <hr class="my-6 border-brand-primary" />
        <div class="flex flex-col items-center justify-between gap-4 text-xs md:flex-row">
          <div class="flex flex-wrap items-center justify-center md:justify-start gap-2">
            <p>© {new Date().getFullYear()} Muhammad Zaki Rifa'at. All rights reserved.</p>
            <a 
              href={`${cleanBase}archive/`} 
              class="inline-flex items-center gap-1 text-[9px] font-mono text-brand-muted/50 hover:text-brand-accent hover:border-brand-accent/30 bg-brand-primary/30 border border-brand-primary px-2 py-0.5 rounded transition-all duration-200"
              title="View Archived Projects"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
              </svg>
              System Archive
            </a>
          </div>
          <p>Built with <a href="https://astro.build/" target="_blank" rel="noopener noreferrer" class="text-brand-text hover:text-brand-accent cursor-pointer">Astro</a> and <a href="https://tailwindcss.com/" target="_blank" rel="noopener noreferrer" class="text-brand-text hover:text-brand-accent cursor-pointer">Tailwind CSS</a>.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
