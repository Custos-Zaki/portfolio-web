---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillGrid from '../components/SkillGrid.astro';

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const baseUrl = import.meta.env.BASE_URL;
const cleanBase = baseUrl.endsWith('/') ? baseUrl : baseUrl + '/';
---

<Layout title="Muhammad Zaki Rifa'at | Quantitative Research & Statistical Modeling">
  <!-- Hero Section -->
  <section class="relative overflow-hidden py-16 sm:py-24 border-b border-brand-primary/50">
    <!-- Grid overlay pattern -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-brand-accent/5 via-transparent to-transparent"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b12_1px,transparent_1px),linear-gradient(to_bottom,#1e293b12_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>

    <div class="relative z-10 mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center sm:text-left">
      <div class="flex flex-col sm:flex-row items-center gap-8 md:gap-12">
        <!-- Profile Avatar -->
        <div class="relative flex-shrink-0 animate-fade-in">
          <div class="absolute -inset-0.5 rounded-full bg-gradient-to-r from-brand-accent to-brand-secondary opacity-75 blur-md"></div>
          <div class="relative h-32 w-32 md:h-40 md:w-40 overflow-hidden rounded-full border-2 border-brand-accent/30 bg-brand-primary">
            <img 
              src={`${cleanBase}images/profil_pictures.png`} 
              alt="Muhammad Zaki Rifa'at" 
              class="h-full w-full object-cover"
            />
          </div>
        </div>

        <!-- Bio Content -->
        <div class="flex-grow animate-fade-in-up">
          <div class="inline-flex items-center rounded-full bg-brand-accent/10 px-3 py-1 text-xs font-semibold text-brand-accent border border-brand-accent/20 mb-4">
            <span class="mr-1.5 h-1.5 w-1.5 rounded-full bg-brand-accent animate-pulse"></span> Available for Research
          </div>
          <h1 class="font-display text-3xl font-extrabold tracking-tight text-brand-text sm:text-4xl md:text-5xl leading-tight">
            Muhammad Zaki Rifa'at
          </h1>
          <p class="mt-2 font-display text-lg font-bold text-brand-accent sm:text-xl">
            Quantitative Research & Statistical Modeling
          </p>
          <h2 class="mt-4 text-base text-brand-text font-medium leading-relaxed max-w-2xl">
            "Statistics Student Building Intelligent Data Systems | Quantitative Researcher & Algorithmic Trading Developer."
          </h2>
          <p class="mt-4 text-sm text-brand-muted leading-relaxed max-w-2xl font-sans">
            I am a Statistics undergraduate at Institut Teknologi Kalimantan (ITK) specializing in the intersection of data science, predictive analytics, and quantitative finance. As a Quantitative Developer, I transform raw datasets into actionable insights through statistical modeling and machine learning approaches. My core focus lies in identifying complex patterns, optimizing decision-making, and engineering end-to-end automated trading systems—specifically integrating ML pipelines into Expert Advisors (EA) for financial markets.
          </p>

          <!-- Social Links / Buttons -->
          <div class="mt-6 flex flex-wrap items-center justify-center sm:justify-start gap-4">
            <a 
              href="#contact" 
              class="inline-flex items-center justify-center rounded-lg bg-brand-accent px-5 py-2.5 text-sm font-semibold text-brand-bg hover:opacity-90 hover:-translate-y-[1px] transition-all duration-200 shadow-brand-md cursor-pointer"
            >
              Get in Touch
            </a>
            <a 
              href="#projects" 
              class="inline-flex items-center justify-center rounded-lg border border-brand-primary bg-brand-primary/20 px-5 py-2.5 text-sm font-semibold text-brand-text hover:bg-brand-primary/40 hover:-translate-y-[1px] transition-all duration-200 cursor-pointer"
            >
              View Work
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects Grid Section -->
  <section id="projects" class="py-16 sm:py-24 border-b border-brand-primary/50">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
        <div>
          <h2 class="font-display text-2xl font-extrabold tracking-tight text-brand-text sm:text-3xl">
            <span class="text-brand-accent">#</span> Research & Analytics Projects
          </h2>
          <p class="mt-1 text-sm text-brand-muted">
            Explore statistical investigations, machine learning modeling, and quantitative solutions.
          </p>
        </div>
        <div class="flex items-center gap-2 text-xs font-mono text-brand-muted">
          <span>Total projects: {sortedProjects.length}</span>
        </div>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        {sortedProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>

  <!-- Skills Grid Section -->
  <section id="skills" class="py-16 sm:py-24 border-b border-brand-primary/50">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 text-center sm:text-left">
        <h2 class="font-display text-2xl font-extrabold tracking-tight text-brand-text sm:text-3xl">
          <span class="text-brand-accent">#</span> Technical Skills & Competencies
        </h2>
        <p class="mt-1 text-sm text-brand-muted">
          My primary areas of expertise, spanning statistical computation, machine learning pipelines, and systems.
        </p>
      </div>

      <SkillGrid />
    </div>
  </section>

  <!-- About / Research Philosophy Section -->
  <section id="about" class="py-16 sm:py-24 border-b border-brand-primary/50">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-3 items-start">
        <div class="md:col-span-1">
          <h2 class="font-display text-2xl font-extrabold tracking-tight text-brand-text sm:text-3xl">
            <span class="text-brand-accent">#</span> Research Philosophy
          </h2>
          <p class="mt-2 text-sm text-brand-muted font-sans leading-relaxed">
            How I approach data problems, mathematical verification, and system architecture.
          </p>
        </div>
        <div class="md:col-span-2 space-y-6 text-sm text-brand-muted leading-relaxed font-sans">
          <p>
            As a statistician, I firmly believe that data should not just be fitted to models, but thoroughly interrogated to understand its underlying structure. Whether resolving the acoustic characteristics of music catalogs or forecasting retail customer lifetime value, my workflow starts with strict mathematical validation and deep exploratory analyses.
          </p>
          <p>
            In quantitative finance, this translates into a discipline of rigorous backtesting. I focus on developing algorithmic trading systems (Expert Advisors) in <strong class="text-brand-text">MQL5</strong> that avoid overfitting, respect transaction frictions (spreads, slippage, latency), and utilize machine learning classifiers as probability filters rather than absolute predictors.
          </p>
          <div class="rounded-xl border border-brand-primary bg-brand-primary/20 p-5">
            <h4 class="font-display text-sm font-bold text-brand-text mb-2">Core Analytical Frameworks</h4>
            <ul class="list-disc pl-5 space-y-1 text-xs">
              <li>Non-parametric correlation and multivariate hypothesis tests</li>
              <li>Dimensionality reduction (PCA) and acoustic fingerprint clustering</li>
              <li>Probabilistic purchasing modeling (BG/NBD + Gamma-Gamma)</li>
              <li>Robust backtesting and walk-forward parameter optimization</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="py-16 sm:py-24 bg-brand-primary/10">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-2xl font-extrabold tracking-tight text-brand-text sm:text-3xl mb-4">
        Let's Build Something Intelligent
      </h2>
      <p class="text-sm text-brand-muted max-w-xl mx-auto mb-8 font-sans leading-relaxed">
        I am always open to collaborating on quantitative research projects, statistical modeling contracts, or algorithmic system design. Let's discuss your next data pipeline.
      </p>

      <div class="flex flex-col sm:flex-row justify-center items-center gap-6">
        <a 
          href="mailto:custos.quant@gmail.com" 
          class="inline-flex items-center gap-2 rounded-lg bg-brand-accent px-6 py-3 text-sm font-semibold text-brand-bg hover:opacity-90 transition-all duration-200 cursor-pointer shadow-brand-md hover:-translate-y-[1px]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Email Me
        </a>
        <a 
          href="https://www.linkedin.com/in/muhammad-zaki-rifaat/" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-2 rounded-lg border border-brand-primary bg-brand-bg px-6 py-3 text-sm font-semibold text-brand-text hover:bg-brand-primary/30 transition-all duration-200 cursor-pointer hover:-translate-y-[1px]"
        >
          Connect on LinkedIn
        </a>
      </div>
    </div>
  </section>
</Layout>
