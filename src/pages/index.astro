---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillGrid from '../components/SkillGrid.astro';

const projects = await getCollection('projects');
const activeProjects = projects.filter((p) => !p.data.archived);
const sortedProjects = activeProjects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const baseUrl = import.meta.env.BASE_URL;
const cleanBase = baseUrl.endsWith('/') ? baseUrl : baseUrl + '/';
---

<Layout 
  title="Muhammad Zaki Rifa'at | Data Science & Machine Learning Portfolio"
  description="Portfolio of Muhammad Zaki Rifa'at, Data Scientist & Machine Learning Engineer specializing in predictive modeling, business analytics, and data pipeline solutions."
>
  <!-- MAIN FRZN SURFACE WRAPPER -->
  <div class="relative bg-[#4E6172] text-white selection:bg-white selection:text-[#1E2936]">

    <!-- TOP HUD TECHNICAL BAR (Adaptasi Header FRZN) -->
    <div class="w-full max-w-[1360px] mx-auto px-6 sm:px-10 pt-6 pb-4 flex flex-wrap items-center justify-between gap-4 border-b border-white/15 text-[10px] sm:text-[11px] font-mono tracking-[0.14em] uppercase z-30 relative">
      <div class="flex items-center gap-3">
        <span class="font-display text-2xl tracking-tight text-white leading-none">MZR<sup class="text-[10px] font-mono ml-0.5">™</sup></span>
        <span class="hidden sm:inline-block text-[#879BAE]">// QUANT_PORTFOLIO</span>
      </div>

      <nav class="hidden md:flex items-center gap-8 text-[#B0C2D1]">
        <a href="#overview" class="hover:text-white transition-colors">[ OVERVIEW ]</a>
        <a href="#metrics" class="hover:text-white transition-colors">[ TELEMETRY ]</a>
        <a href="#projects" class="hover:text-white transition-colors">[ PROJECTS ]</a>
        <a href="#skills" class="hover:text-white transition-colors">[ COMPETENCIES ]</a>
        <a href="#contact" class="hover:text-white transition-colors">[ CONTACT ]</a>
      </nav>

      <div class="flex items-center gap-2">
        <a 
          href="#projects" 
          title="Explore Projects"
          class="w-6 h-6 rounded-[4px] bg-white text-[#1E2936] flex items-center justify-center font-bold text-xs hover:bg-[#B8C9D9] transition-colors"
        >
          ⌗
        </a>
        <a 
          href="mailto:custos.quant@gmail.com" 
          title="Email Muhammad Zaki Rifa'at"
          class="w-6 h-6 rounded-[4px] bg-white text-[#1E2936] flex items-center justify-center font-bold text-xs hover:bg-[#B8C9D9] transition-colors"
        >
          ✉
        </a>
      </div>
    </div>

    <!-- ===================================================================
         HERO SECTION (Adaptasi dari COLLECTION ARTIC 01™)
         =================================================================== -->
    <section id="overview" class="relative overflow-hidden pt-10 pb-16 sm:py-20 border-b border-white/20 bg-gradient-to-b from-[#3E5060] via-[#4E6172] to-[#3B4C5C]">
      
      <!-- Latar Graffiti Airbrush Blur (Motif Visual FRZN) -->
      <div aria-hidden="true" class="graffiti-watermark absolute inset-x-0 top-6 text-center text-[11rem] sm:text-[16rem] lg:text-[21rem] uppercase z-0 select-none">
        DATA // ML
      </div>

      <div class="relative z-10 w-full max-w-[1360px] mx-auto px-6 sm:px-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
          
          <!-- KOLOM KIRI (5 Kolom): Judul Masif, Spesifikasi & Tombol Dekagon -->
          <div class="lg:col-span-5 space-y-6 text-left">
            <div class="inline-flex items-center gap-2 text-[10px] font-mono tracking-[0.16em] text-[#B0C2D1] uppercase">
              <span class="h-2 w-2 rounded-full bg-white animate-pulse"></span>
              <span>[ STATUS: AVAILABLE FOR PROJECTS // ITK_STATISTICS ]</span>
            </div>

            <div>
              <p class="text-xs font-mono tracking-[0.18em] text-[#B8C9D9] uppercase mb-2">
                MUHAMMAD ZAKI RIFA'AT
              </p>
              <h1 class="font-display text-5xl sm:text-6xl xl:text-7xl leading-[0.9] tracking-tight text-white uppercase">
                DATA SCIENCE<br />
                & ML ENG 01<sup class="text-2xl sm:text-3xl ml-1 font-sans font-bold">™</sup>
              </h1>
            </div>

            <!-- Matriks Spesifikasi (Adaptasi dari baris SIZE & COLOUR) -->
            <div class="space-y-3 pt-2 text-[10px] sm:text-[11px] font-mono tracking-[0.12em] uppercase border-y border-white/15 py-4">
              <div class="flex items-center gap-4 sm:gap-6">
                <span class="text-[#879BAE] w-20 shrink-0">FOCUS</span>
                <div class="flex flex-wrap gap-4 text-white">
                  <span class="border-b border-white pb-0.5">PREDICTIVE</span>
                  <span class="text-[#B0C2D1]">ANALYTICS</span>
                  <span class="text-[#B0C2D1]">PIPELINES</span>
                </div>
              </div>
              <div class="flex items-center gap-4 sm:gap-6">
                <span class="text-[#879BAE] w-20 shrink-0">FOUNDATION</span>
                <div class="flex flex-wrap gap-4 text-white">
                  <span class="text-[#B0C2D1]">STATISTICS (ITK)</span>
                  <span class="border-b border-white pb-0.5">PRODUCTION ML</span>
                </div>
              </div>
            </div>

            <!-- Baris Aksi Utama: Tombol Poligon Dekagon (Adaptasi dari $899.99 CTA) -->
            <div class="flex flex-wrap items-center gap-6 pt-2">
              <a 
                href="#contact" 
                class="btn-polygon w-20 h-20 relative group shrink-0"
                aria-label="Get in Touch"
              >
                <svg viewBox="0 0 100 100" class="w-full h-full fill-white/5 stroke-white/45 group-hover:stroke-white group-hover:fill-white/15 transition-all" stroke-width="1.5">
                  <polygon points="50,2 80,12 98,38 98,62 80,88 50,98 20,88 2,62 2,38 20,12" />
                </svg>
                <span class="absolute text-xl text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">↗</span>
              </a>

              <div class="space-y-1">
                <span class="block text-[10px] font-mono tracking-[0.14em] text-[#B0C2D1] uppercase">
                  INITIATE COLLABORATION
                </span>
                <a href="#contact" class="block text-xl sm:text-2xl font-mono font-semibold tracking-wider text-white hover:text-[#B8C9D9] transition-colors">
                  GET IN TOUCH
                </a>
                <a href="#projects" class="inline-block text-[10px] font-mono tracking-[0.14em] text-[#B8C9D9] underline underline-offset-4 hover:text-white uppercase">
                  [ VIEW DEPLOYED PROJECTS ↓ ]
                </a>
              </div>
            </div>
          </div>

          <!-- KOLOM TENGAH (3 Kolom): Subjek Potret Utama -->
          <div class="lg:col-span-3 flex flex-col items-center justify-center relative">
            <div class="relative group">
              <!-- Bingkai Chamfered Glacier untuk Foto Profil -->
              <div class="clip-chamfer-br bg-[#B8C9D9] p-2 shadow-2xl border border-white/40 relative">
                <img 
                  src={`${cleanBase}images/profil_pictures.png`} 
                  alt="Muhammad Zaki Rifa'at" 
                  class="clip-chamfer-sm h-72 w-60 sm:h-80 sm:w-64 object-cover object-top filter contrast-105 group-hover:scale-[1.02] transition-transform duration-500"
                />
                <!-- Tag Koordinat di Sudut Gambar -->
                <div class="absolute bottom-4 left-4 bg-[#1E2936]/90 text-white px-2.5 py-1 text-[9px] font-mono tracking-[0.14em] uppercase">
                  ID // MZR_01
                </div>
              </div>
              <!-- Bayangan Lantai Radial -->
              <div class="glacier-floor-shadow h-6 w-4/5 mx-auto mt-3 rounded-full"></div>
            </div>
          </div>

          <!-- KOLOM KANAN (4 Kolom): 2 Kartu Preview Glacier & Bio Statement -->
          <div class="lg:col-span-4 flex flex-col items-stretch lg:items-end space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 w-full">
              
              <!-- Preview Card 01: Core Value Proposition -->
              <div class="clip-chamfer-sm bg-[#B8C9D9] text-[#1E2936] p-5 flex flex-col justify-between min-h-[210px] shadow-lg">
                <div class="flex items-center justify-between text-[9px] font-mono tracking-[0.14em] text-[#2D3E4E] uppercase">
                  <span>[ MISSION_01 ]</span>
                  <span class="w-2 h-2 rounded-full bg-[#1E2936]"></span>
                </div>
                <p class="font-sans text-xs sm:text-[13px] font-semibold leading-snug text-[#1E2936] my-3">
                  "I turn business data into measurable outcomes — predictive models, automated pipelines, and analysis that actually supports decisions."
                </p>
                <div class="text-[9px] font-mono tracking-[0.12em] uppercase text-[#2D3E4E] border-t border-[#1E2936]/15 pt-2">
                  MEASURABLE IMPACT
                </div>
              </div>

              <!-- Preview Card 02: Engineering Bio -->
              <div class="clip-chamfer-sm bg-[#95AABF] text-[#1E2936] p-5 flex flex-col justify-between min-h-[210px] shadow-lg">
                <div class="flex items-center justify-between text-[9px] font-mono tracking-[0.14em] text-[#1E2936] uppercase">
                  <span>[ ARCHITECTURE_02 ]</span>
                  <span class="w-2 h-2 rounded-full bg-white"></span>
                </div>
                <p class="font-sans text-[11px] leading-relaxed text-[#1E2936]/90 my-2">
                  Building end-to-end data solutions: ML models predicting real outcomes, automated pipelines, and statistical validation backed by Statistics at Institut Teknologi Kalimantan (ITK).
                </p>
                <div class="text-[9px] font-mono tracking-[0.12em] uppercase text-[#1E2936] border-t border-[#1E2936]/15 pt-2">
                  ITK // STATISTICS
                </div>
              </div>

            </div>

            <!-- Baris Indikator Slide (01 ─── 03) & Ikon Navigasi Putih Solid -->
            <div class="w-full flex items-center justify-between pt-2">
              <div class="flex items-center gap-3 text-[10px] font-mono tracking-[0.15em] text-[#B0C2D1]">
                <span class="text-white">01</span>
                <span class="w-12 h-[1px] bg-white/35"></span>
                <span>03</span>
              </div>

              <div class="flex items-center gap-2">
                <a href="#metrics" class="w-6 h-6 rounded-[4px] bg-white text-[#1E2936] flex items-center justify-center text-[10px] font-bold hover:bg-[#B8C9D9] transition-colors" title="Metrics">
                  01
                </a>
                <a href="#projects" class="w-6 h-6 rounded-[4px] bg-white text-[#1E2936] flex items-center justify-center text-[10px] font-bold hover:bg-[#B8C9D9] transition-colors" title="Projects">
                  02
                </a>
                <a href="#skills" class="w-6 h-6 rounded-[4px] bg-white text-[#1E2936] flex items-center justify-center text-[10px] font-bold hover:bg-[#B8C9D9] transition-colors" title="Skills">
                  03
                </a>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ===================================================================
         METRICS SECTION (Kartu Spesifikasi Teknis Bersudut Potong)
         =================================================================== -->
    <section id="metrics" class="py-12 border-b border-white/15 bg-[#2D3E4E]/50">
      <div class="w-full max-w-[1360px] mx-auto px-6 sm:px-10">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          
          <!-- Metric 01 -->
          <div class="clip-chamfer-sm bg-[#2D3E4E] border border-white/15 p-6 flex flex-col justify-between">
            <div class="flex items-center justify-between text-[10px] font-mono tracking-[0.14em] text-[#B0C2D1] uppercase mb-3">
              <span>[ METRIC_01 // EXPERIENCE ]</span>
              <span class="inline-flex items-center gap-1.5 text-white">
                <i class="w-2 h-2 rounded-full bg-white inline-block"></i> ACTIVE
              </span>
            </div>
            <div class="font-display text-5xl sm:text-6xl text-white leading-none my-1">
              3+
            </div>
            <div class="text-[11px] font-mono tracking-[0.08em] text-[#B8C9D9] uppercase pt-3 border-t border-white/10">
              Years in Data & ML Systems
            </div>
          </div>

          <!-- Metric 02 -->
          <div class="clip-chamfer-sm bg-[#2D3E4E] border border-white/15 p-6 flex flex-col justify-between">
            <div class="flex items-center justify-between text-[10px] font-mono tracking-[0.14em] text-[#B0C2D1] uppercase mb-3">
              <span>[ METRIC_02 // PROJECTS ]</span>
              <span class="inline-flex items-center gap-1.5 text-[#B8C9D9]">
                <i class="w-2 h-2 rounded-full bg-[#4A89C8] inline-block"></i> VERIFIED
              </span>
            </div>
            <div class="font-display text-5xl sm:text-6xl text-white leading-none my-1">
              20+
            </div>
            <div class="text-[11px] font-mono tracking-[0.08em] text-[#B8C9D9] uppercase pt-3 border-t border-white/10">
              ML Experiments & End-to-End Pipelines Built
            </div>
          </div>

          <!-- Metric 03 -->
          <div class="clip-chamfer-sm bg-[#2D3E4E] border border-white/15 p-6 flex flex-col justify-between">
            <div class="flex items-center justify-between text-[10px] font-mono tracking-[0.14em] text-[#B0C2D1] uppercase mb-3">
              <span>[ METRIC_03 // COVERAGE ]</span>
              <span class="inline-flex items-center gap-1.5 text-white">
                <i class="w-2 h-2 rounded-full bg-[#B8C9D9] inline-block"></i> END-TO-END
              </span>
            </div>
            <div class="font-display text-5xl sm:text-6xl text-white leading-none my-1">
              FULL
            </div>
            <div class="text-[11px] font-mono tracking-[0.08em] text-[#B8C9D9] uppercase pt-3 border-t border-white/10">
              Business Analytics · Predictive Modeling · Pipeline Engineering
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ===================================================================
         PROJECTS GRID SECTION (Adaptasi dari NEW COLLECTION + Bento Katalog)
         =================================================================== -->
    <section id="projects" class="py-16 sm:py-24 border-b border-white/15">
      <div class="w-full max-w-[1360px] mx-auto px-6 sm:px-10">
        
        <!-- Header Bar Katalog: Judul Masif + 2 Kolom Metadata + Tombol Pill Putih -->
        <div class="flex flex-wrap items-start justify-between gap-8 mb-12 pb-6 border-b border-white/15">
          <div>
            <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl leading-[0.92] text-white uppercase">
              SELECTED RESEARCH & ANALYTICS
            </h2>
            <p class="mt-2 text-xs font-mono tracking-[0.1em] text-[#B0C2D1] uppercase">
              Explore statistical investigations, machine learning modeling, and quantitative solutions.
            </p>
          </div>

          <!-- Dual Monospace Metadata Columns (Persis di tengah Header NEW COLLECTION) -->
          <div class="flex gap-10 text-[10px] font-mono leading-[1.65] tracking-[0.12em] text-[#B0C2D1] uppercase">
            <div>
              <p class="text-white">[ ARCHIVE_INDEX ]</p>
              <p>[ QUANT_MODELS ]</p>
              <p>[ DATA_PIPELINES ]</p>
            </div>
            <div>
              <p>PREDICTIVE MODELING</p>
              <p>STATISTICAL INFERENCE</p>
              <p>AUTOMATED ETL</p>
              <p>DECISION SYSTEMS</p>
            </div>
          </div>

          <!-- Solid White Pill Badge (Adaptasi dari tombol FILTERS) -->
          <div class="px-5 py-2 bg-white text-[#1E2936] text-[11px] font-mono font-bold tracking-[0.14em] uppercase rounded-[4px] shadow-sm">
            TOTAL PROJECTS: {sortedProjects.length}
          </div>
        </div>

        <!-- Baris Bento Pengantar (Adaptasi dari Kartu AURORA™) + Grid Proyek -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-10">
          <!-- Kartu Flagship Feature (Gaya AURORA™) -->
          <div class="lg:col-span-4 clip-chamfer-br bg-[#2D3E4E] p-7 flex flex-col justify-between relative overflow-hidden border border-white/15 min-h-[260px]">
            <div aria-hidden="true" class="graffiti-watermark absolute -bottom-6 -left-4 text-8xl uppercase">
              MZR™
            </div>

            <div class="relative z-10 flex items-center justify-between text-[10px] font-mono tracking-[0.14em] text-[#B0C2D1] uppercase">
              <span>[ PRODUCTION_ARCHIVE ]</span>
              <span>ITK // QUANT</span>
            </div>

            <div class="relative z-10 my-6 text-right">
              <h3 class="font-display text-4xl sm:text-5xl leading-none text-white uppercase">
                QUANT LAB<sup class="text-sm ml-1 font-sans">™</sup>
              </h3>
              <p class="text-[11px] font-mono tracking-[0.1em] text-[#B8C9D9] uppercase mt-2">
                VALIDATED STATISTICAL & ML REPOSITORIES
              </p>
            </div>

            <div class="relative z-10 flex items-center justify-end gap-3 pt-4 border-t border-white/10">
              <a 
                href="mailto:custos.quant@gmail.com" 
                class="w-9 h-9 rounded-full border border-white/40 flex items-center justify-center text-xs text-white hover:bg-white hover:text-[#1E2936] transition-colors"
                aria-label="Request Custom Case Study"
              >
                ↗
              </a>
              <div class="text-left text-[10px] font-mono tracking-[0.12em] uppercase">
                <span class="block text-[#879BAE]">ACTIVE REPOS</span>
                <span class="text-white font-bold">{sortedProjects.length} DEPLOYED</span>
              </div>
            </div>
          </div>

          <!-- Kolom Deskripsi Metodologi (Glacier Surface) -->
          <div class="lg:col-span-8 clip-chamfer-br bg-[#B8C9D9] text-[#1E2936] p-7 sm:p-8 flex flex-col justify-between relative overflow-hidden">
            <div class="flex flex-wrap items-center justify-between gap-2 text-[10px] font-mono tracking-[0.14em] text-[#2D3E4E] uppercase">
              <span>[ METHODOLOGY // END-TO-END PIPELINE ]</span>
              <div class="flex items-center gap-3">
                <span class="inline-flex items-center gap-1"><i class="w-2 h-2 rounded-full bg-[#1E2936] inline-block"></i> PYTHON</span>
                <span class="inline-flex items-center gap-1"><i class="w-2 h-2 rounded-full bg-[#2C5EAD] inline-block"></i> SQL</span>
                <span class="inline-flex items-center gap-1"><i class="w-2 h-2 rounded-full bg-white inline-block"></i> MLOPS</span>
              </div>
            </div>

            <div class="my-6 max-w-2xl">
              <h3 class="font-display text-3xl sm:text-4xl text-[#1E2936] leading-tight uppercase">
                FROM RAW TELEMETRY TO PRODUCTION DECISIONS
              </h3>
              <p class="mt-2 font-sans text-xs sm:text-sm text-[#1E2936]/85 leading-relaxed">
                Every project below combines rigorous statistical hypothesis testing with scalable machine learning engineering—ensuring models are interpretable, reproducible, and aligned with measurable KPIs.
              </p>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-[#1E2936]/15 text-[10px] font-mono tracking-[0.12em] text-[#2D3E4E] uppercase">
              <span>PROTOCOL // STATISTICAL_RIGOR_V6</span>
              <span>STATUS // READY FOR AUDIT</span>
            </div>
          </div>
        </div>

        <!-- Daftar Kartu Proyek (Komponen ProjectCard Asli dengan Pembungkus Chamfered FRZN) -->
        <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
          {sortedProjects.map((project, index) => (
            <div class="group flex flex-col space-y-2">
              <div class="clip-chamfer-br bg-[#2D3E4E] p-1.5 border border-white/15 group-hover:border-white/50 transition-all duration-300 h-full flex flex-col justify-between">
                <ProjectCard project={project} />
              </div>
              <!-- Metadata Bar di Bawah Kartu (Persis Gaya Katalog FRZN) -->
              <div class="flex items-center justify-between px-1 text-[10px] font-mono tracking-[0.12em] text-[#B0C2D1] uppercase">
                <div class="flex items-center gap-2">
                  <span class="inline-block w-2 h-2 rounded-full bg-white"></span>
                  <span class="inline-block w-2 h-2 rounded-full bg-[#B8C9D9]"></span>
                  <span class="text-white">CASE_0{index + 1}</span>
                </div>
                <span class="text-[#879BAE]">DEPLOYED // ML</span>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- ===================================================================
         SKILLS GRID SECTION (Technical Competencies)
         =================================================================== -->
    <section id="skills" class="py-16 sm:py-24 border-b border-white/15 bg-[#2D3E4E]/35">
      <div class="w-full max-w-[1360px] mx-auto px-6 sm:px-10">
        <div class="flex flex-wrap items-end justify-between gap-6 mb-10 pb-6 border-b border-white/15">
          <div>
            <p class="text-[10px] font-mono tracking-[0.16em] text-[#879BAE] uppercase mb-2">
              [ SYSTEM CAPABILITIES // TECH_MATRIX ]
            </p>
            <h2 class="font-display text-4xl sm:text-5xl text-white leading-none uppercase">
              TECHNICAL COMPETENCIES
            </h2>
          </div>
          <div class="text-[10px] font-mono tracking-[0.14em] text-[#B0C2D1] uppercase">
            [ VERIFIED STACK // PRODUCTION & RESEARCH ]
          </div>
        </div>

        <div class="clip-chamfer-br bg-[#2D3E4E]/80 border border-white/15 p-6 sm:p-10">
          <SkillGrid />
        </div>
      </div>
    </section>

    <!-- ===================================================================
         CONTACT & MANIFESTO FOOTER (Adaptasi dari BUILT FOR COLD...)
         =================================================================== -->
    <section id="contact" class="relative pt-24 pb-16 overflow-hidden bg-gradient-to-b from-[#3B4C5C] via-[#2D3E4E] to-[#1E2936]">
      
      <!-- Graffiti Tag Raksasa di Latar Belakang Footer -->
      <div aria-hidden="true" class="graffiti-watermark absolute inset-x-0 top-10 text-center text-[10rem] sm:text-[15rem] lg:text-[19rem] uppercase z-0">
        CUSTOS // ML
      </div>

      <div class="relative z-10 w-full max-w-[1360px] mx-auto px-6 sm:px-10">
        
        <!-- Baris Kutipan Manifesto Kiri & Kanan (Persis Posisi Teks di Atas Gunung) -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-10 mb-20 text-[10px] sm:text-[11px] font-mono tracking-[0.12em] leading-[1.6] uppercase">
          <div class="max-w-xs space-y-3">
            <p class="text-white">
              ENGINEERED WITH STATISTICAL PRECISION. NOT AS A TREND, BUT AS A MEASURABLE RESPONSE TO BUSINESS COMPLEXITY.
            </p>
            <p class="text-[#879BAE]">
              [ PROTOCOL: QUANT_OPS_01 // ITK ]
            </p>
          </div>

          <div class="max-w-xs md:text-right space-y-2">
            <p class="text-white">
              FOR TEAMS THAT BUILD INTELLIGENT SYSTEMS, NOT JUST DASHBOARDS.
            </p>
            <p class="text-[#B8C9D9]">
              OPEN FOR RESEARCH & ML CONTRACTS
            </p>
          </div>
        </div>

        <!-- Panel Call-To-Action Kontak Tengah -->
