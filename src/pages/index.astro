---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillGrid from '../components/SkillGrid.astro';

const projects = await getCollection('projects');
const activeProjects = projects.filter((p) => !p.data.archived);
const sortedProjects = activeProjects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const baseUrl = import.meta.env.BASE_URL;
const cleanBase = baseUrl.endsWith('/') ? baseUrl : baseUrl + '/';
---

<Layout 
  title="Muhammad Zaki Rifa'at | Data Science & Machine Learning Portfolio"
  description="Portfolio of Muhammad Zaki Rifa'at, Data Scientist & Machine Learning Engineer specializing in predictive modeling, business analytics, and data pipeline solutions."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden py-16 sm:py-24 border-b border-brand-secondary/60">
    <!-- Grid overlay pattern -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-brand-accent/5 via-transparent to-transparent"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#4bb8fa05_1px,transparent_1px),linear-gradient(to_bottom,#4bb8fa05_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>

    <div class="relative z-10 mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center sm:text-left">
      <div class="flex flex-col sm:flex-row items-center gap-8 md:gap-12">
        
        <!-- Profile Hexagon Avatar & Orbits -->
        <div class="relative flex items-center justify-center p-6 select-none flex-shrink-0 animate-fade-in mx-auto sm:mx-0">
          <!-- Strongest spotlight glow behind Profile Avatar -->
          <div class="absolute inset-0 -z-10 h-[280px] w-[280px] m-auto rounded-full bg-[radial-gradient(circle,_#4bb8fa_0%,_#2c5ead_45%,_transparent_75%)] opacity-40 blur-[35px] pointer-events-none"></div>

          <!-- Hexagon Wrapper -->
          <div class="relative z-10">
            <div class="hexagon-wrapper">
              <div class="hexagon-border"></div>
              <div class="hexagon-inner">
                <img 
                  src={`${cleanBase}images/profil_pictures.png`} 
                  alt="Quantitative Developer Profile" 
                  class="h-full w-full object-cover object-top scale-[1.03] transition-transform duration-500 hover:scale-105"
                />
              </div>
            </div>
          </div>

          <!-- Desktop Floating Orbit Tags -->
          <div class="hidden md:block absolute inset-0 z-20 pointer-events-none">
            <span class="absolute top-[10%] left-[-20px] px-2.5 py-0.5 rounded border border-brand-accent/30 bg-brand-primary/95 text-[10px] font-mono text-brand-accent shadow-[0_0_8px_rgba(75,184,250,0.15)]">Python</span>
            <span class="absolute top-[38%] left-[-40px] px-2 py-0.5 rounded border border-brand-muted/20 bg-brand-primary/90 text-[9px] font-mono text-brand-muted">R</span>
            <span class="absolute bottom-[20%] left-[-30px] px-2.5 py-0.5 rounded border border-brand-accent/20 bg-brand-primary/95 text-[10px] font-mono text-brand-text">Machine Learning</span>
            <span class="absolute bottom-[-5%] left-[20px] px-2.5 py-0.5 rounded border border-brand-muted/20 bg-brand-primary/90 text-[10px] font-mono text-brand-muted">SQL</span>
            
            <span class="absolute top-[5%] right-[-10px] px-2.5 py-0.5 rounded border border-brand-muted/20 bg-brand-primary/90 text-[10px] font-mono text-brand-muted">Time Series</span>
            <span class="absolute top-[35%] right-[-40px] px-2.5 py-0.5 rounded border border-brand-accent/20 bg-brand-primary/95 text-[10px] font-mono text-brand-text shadow-[0_0_8px_rgba(44,94,173,0.08)]">Statistical Modeling</span>
            <span class="absolute bottom-[25%] right-[-30px] px-2.5 py-0.5 rounded border border-brand-accent/30 bg-brand-primary/95 text-[10px] font-mono text-brand-accent">MQL5</span>
            <span class="absolute bottom-[-5%] right-[0px] px-2.5 py-0.5 rounded border border-brand-muted/20 bg-brand-primary/90 text-[10px] font-mono text-brand-muted">Forecasting</span>
          </div>
        </div>

        <!-- Bio Content -->
        <div class="flex-grow animate-fade-in-up">
          <div class="inline-flex items-center rounded bg-brand-accent/10 px-3 py-1 text-xs font-mono text-brand-accent border border-brand-accent/20 mb-4 justify-center sm:justify-start">
            <span class="mr-1.5 h-1.5 w-1.5 rounded-full bg-brand-accent animate-pulse"></span> Available for Projects
          </div>
          <h1 class="font-display text-3xl font-extrabold tracking-tight bg-gradient-to-r from-brand-text via-brand-text to-brand-accent bg-clip-text text-transparent sm:text-4xl md:text-5xl leading-tight pb-1">
            Data Scientist & Machine Learning Engineer
          </h1>
          <p class="mt-2 font-display text-lg font-bold bg-gradient-to-r from-brand-accent to-brand-violet bg-clip-text text-transparent sm:text-xl inline-block">
            Predictive Modeling · Business Analytics · Data Pipeline Solutions
          </p>
          <h2 class="mt-4 text-base text-brand-text/90 font-medium leading-relaxed max-w-2xl font-sans">
            "I turn business data into measurable outcomes — predictive models, automated pipelines, and analysis that actually supports decisions."
          </h2>
          <p class="mt-4 text-sm text-brand-muted leading-relaxed max-w-2xl font-sans">
            I build end-to-end data solutions: machine learning models that predict real business outcomes, data pipelines that automate collection and reporting, and statistical analysis that validates findings before they reach production. With a rigorous foundation in Statistics from Institut Teknologi Kalimantan (ITK), I combine academic precision with hands-on engineering experience — working across the full stack from raw data ingestion to deployed model.
          </p>
 
          <!-- Social Links / Buttons -->
          <div class="mt-6 flex flex-wrap items-center justify-center sm:justify-start gap-4">
            <a 
              href="#contact" 
              class="inline-flex items-center justify-center rounded-lg bg-gradient-to-r from-brand-accent to-brand-violet px-5 py-2.5 text-sm font-semibold text-brand-bg hover:opacity-90 hover:shadow-[0_0_20px_rgba(123,97,255,0.35)] hover:-translate-y-[1px] transition-all duration-200 cursor-pointer"
            >
              Get in Touch
            </a>
            <a 
              href="#projects" 
              class="inline-flex items-center justify-center rounded-lg border border-brand-secondary bg-brand-primary/40 px-5 py-2.5 text-sm font-semibold text-brand-text hover:bg-brand-primary hover:border-brand-accent/30 hover:-translate-y-[1px] transition-all duration-200 cursor-pointer"
            >
              View Projects
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Metrics Section -->
  <section class="py-12 border-b border-brand-secondary/60 bg-brand-primary/20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <!-- Card 1 -->
        <div class="border border-brand-secondary/80 bg-brand-primary/50 rounded-xl p-5 text-center transition-all duration-200 hover:border-brand-accent/30 hover:shadow-[0_0_15px_rgba(0,212,255,0.04)]">
          <div class="text-[10px] font-mono tracking-wider text-brand-accent mb-2 uppercase">Experience</div>
          <div class="text-3xl font-display font-extrabold bg-gradient-to-r from-brand-accent to-brand-violet bg-clip-text text-transparent mb-1">3+</div>
          <div class="text-[11px] text-brand-muted font-medium font-sans">Years in Data & ML Systems</div>
        </div>
        <!-- Card 2 -->
        <div class="border border-brand-secondary/80 bg-brand-primary/50 rounded-xl p-5 text-center transition-all duration-200 hover:border-brand-accent/30 hover:shadow-[0_0_15px_rgba(0,212,255,0.04)]">
          <div class="text-[10px] font-mono tracking-wider text-brand-accent mb-2 uppercase">Projects</div>
          <div class="text-3xl font-display font-extrabold bg-gradient-to-r from-brand-accent to-brand-violet bg-clip-text text-transparent mb-1">20+</div>
          <div class="text-[11px] text-brand-muted font-medium font-sans">ML Experiments & End-to-End Pipelines Built</div>
        </div>
        <!-- Card 3 -->
        <div class="border border-brand-secondary/80 bg-brand-primary/50 rounded-xl p-5 text-center transition-all duration-200 hover:border-brand-accent/30 hover:shadow-[0_0_15px_rgba(0,212,255,0.04)]">
          <div class="text-[10px] font-mono tracking-wider text-brand-accent mb-2 uppercase">Coverage</div>
          <div class="text-3xl font-display font-extrabold bg-gradient-to-r from-brand-accent to-brand-violet bg-clip-text text-transparent mb-1">Full</div>
          <div class="text-[11px] text-brand-muted font-medium font-sans">Business Analytics · Predictive Modeling · Pipeline Engineering</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services & Solutions Section -->
  <section id="services" class="py-16 border-b border-brand-primary/50 bg-brand-primary/5">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 text-center sm:text-left">
        <h2 class="font-display text-2xl font-extrabold tracking-tight text-brand-text sm:text-3xl">
          <span class="bg-gradient-to-r from-brand-accent to-brand-violet bg-clip-text text-transparent font-extrabold">#</span> Solutions & Client Services
        </h2>
        <p class="mt-1 text-sm text-brand-muted">
          I provide end-to-end data science, predictive modeling, and data engineering solutions.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-3">
        <!-- Service 1: Predictive Machine Learning -->
        <div class="border border-brand-secondary/60 bg-brand-primary p-6 rounded-xl transition-all duration-300 hover:border-brand-accent/20 hover:shadow-[0_0_15px_rgba(0,212,255,0.04)]">
          <div class="flex items-center gap-3 mb-3">
            <div class="rounded-lg bg-brand-accent/10 p-2 text-brand-accent border border-brand-accent/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 9.172V5L8 4z" />
              </svg>
            </div>
            <h3 class="font-display text-base font-bold text-brand-text">Predictive Machine Learning</h3>
          </div>
          <p class="text-xs text-brand-muted leading-relaxed font-sans">
            Building classification, regression, and clustering models for real business problems — customer churn, lifetime value modeling, demand forecasting, and behavioral segmentation. Clean pipelines from raw data to working model.
          </p>
        </div>

        <!-- Service 2: Statistical Analysis & Research -->
        <div class="border border-brand-secondary/60 bg-brand-primary p-6 rounded-xl transition-all duration-300 hover:border-brand-accent/20 hover:shadow-[0_0_15px_rgba(0,212,255,0.04)]">
          <div class="flex items-center gap-3 mb-3">
            <div class="rounded-lg bg-brand-violet/10 p-2 text-brand-violet border border-brand-violet/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2m0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 002 2h2a2 2 0 002-2" />
              </svg>
            </div>
            <h3 class="font-display text-base font-bold text-brand-text">Statistical Analysis & Research</h3>
          </div>
          <p class="text-xs text-brand-muted leading-relaxed font-sans">
            Rigorous hypothesis testing, exploratory data analysis, A/B testing, and correlation analysis to extract reliable, defensible insights from your data. Results you can act on, not just report.
          </p>
        </div>

        <!-- Service 3: Data Pipelines & Automation -->
        <div class="border border-brand-secondary/60 bg-brand-primary p-6 rounded-xl transition-all duration-300 hover:border-brand-accent/20 hover:shadow-[0_0_15px_rgba(0,212,255,0.04)]">
          <div class="flex items-center gap-3 mb-3">
            <div class="rounded-lg bg-brand-accent/10 p-2 text-brand-accent border border-brand-accent/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
              </svg>
            </div>
            <h3 class="font-display text-base font-bold text-brand-text">Data Pipelines & Automation</h3>
          </div>
          <p class="text-xs text-brand-muted leading-relaxed font-sans">
            Designing automated data collection scripts, ETL workflows, transaction logging systems, and multi-source integration architectures — so your data is always clean, current, and where it needs to be.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects Grid Section -->
  <section id="projects" class="py-16 sm:py-24 border-b border-brand-primary/50">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
        <div>
          <h2 class="font-display text-2xl font-extrabold tracking-tight text-brand-text sm:text-3xl">
            <span class="bg-gradient-to-r from-brand-accent to-brand-violet bg-clip-text text-transparent font-extrabold">#</span> Research & Analytics Projects
          </h2>
          <p class="mt-1 text-sm text-brand-muted">
            Explore statistical investigations, machine learning modeling, and quantitative solutions.
          </p>
        </div>
        <div class="flex items-center gap-2 text-xs font-mono text-brand-muted">
          <span>Total projects: {sortedProjects.length}</span>
        </div>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        {sortedProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>

  <!-- Skills Grid Section -->
  <section id="skills" class="py-16 sm:py-24 border-b border-brand-primary/50">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 text-center sm:text-left">
        <h2 class="font-display text-2xl font-extrabold tracking-tight text-brand-text sm:text-3xl">
          <span class="bg-gradient-to-r from-brand-accent to-brand-violet bg-clip-text text-transparent font-extrabold">#</span> Technical Skills & Competencies
        </h2>
        <p class="mt-1 text-sm text-brand-muted">
          My primary areas of expertise, spanning statistical computation, machine learning pipelines, and systems.
        </p>
      </div>

      <SkillGrid />
    </div>
  </section>

  <!-- About / Value Proposition Section -->
  <section id="about" class="py-16 sm:py-24 border-b border-brand-primary/50">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-3 items-start">
        <div class="md:col-span-1">
          <h2 class="font-display text-2xl font-extrabold tracking-tight text-brand-text sm:text-3xl">
            <span class="bg-gradient-to-r from-brand-accent to-brand-violet bg-clip-text text-transparent font-extrabold">#</span> Value Proposition
          </h2>
          <p class="mt-2 text-sm text-brand-muted font-sans leading-relaxed">
            How I approach data problems, project execution, and client collaborations.
          </p>
        </div>
        <div class="md:col-span-2 space-y-6 text-sm text-brand-muted leading-relaxed font-sans">
          <p>
            My workflow starts with the business problem, not the algorithm. Before selecting a model, the question is: what decision does this output need to support, and what does failure actually cost?
          </p>
          <p>
            This means every project begins with thorough data validation and exploratory analysis — checking distributions, hunting for leakage, and confirming that the data actually reflects the problem at hand. The model is built last, not first.
          </p>
          <p>
            For clients, this means fewer surprises in production, cleaner handoffs, and honest communication about what the data can and cannot support. If the signal isn't there, I'll tell you before you pay for a model that won't hold up.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="py-16 sm:py-24 bg-brand-primary/10">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-2xl font-extrabold tracking-tight bg-gradient-to-r from-brand-accent to-brand-violet bg-clip-text text-transparent sm:text-3xl mb-4">
        Let's Build Something Intelligent
      </h2>
      <p class="text-sm text-brand-muted max-w-xl mx-auto mb-8 font-sans leading-relaxed">
        I am always open to collaborating on quantitative research projects, statistical modeling contracts, or algorithmic system design. Let's discuss your next data pipeline.
      </p>

      <div class="flex flex-col sm:flex-row justify-center items-center gap-6">
        <a 
          href="mailto:custos.quant@gmail.com" 
          class="inline-flex items-center gap-2 rounded-lg bg-gradient-to-r from-brand-accent to-brand-violet px-6 py-3 text-sm font-semibold text-brand-bg hover:opacity-90 hover:shadow-[0_0_20px_rgba(123,97,255,0.35)] transition-all duration-200 cursor-pointer hover:-translate-y-[1px]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Email Me
        </a>
        <a 
          href="https://www.linkedin.com/in/muhammad-zaki-rifaat/" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-2 rounded-lg border border-brand-primary bg-brand-bg px-6 py-3 text-sm font-semibold text-brand-text hover:bg-brand-primary/30 transition-all duration-200 cursor-pointer hover:-translate-y-[1px]"
        >
          Connect on LinkedIn
        </a>
      </div>
    </div>
  </section>
</Layout>
